# Copy to .env and fill in. The admin account is created on first start only;
# afterwards change the password from Admin → Settings and remove ADMIN_PASSWORD from here.
ADMIN_EMAIL=ar.jeannejoseph@gmail.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Public URL of the site (used for sitemap, canonical and Open Graph URLs)
SITE_URL=http://localhost:4310
PORT=4310

# Where the SQLite database and uploaded images live. Back this folder up.
DATA_DIR=data

# Set to 1 when served over HTTPS (also implied by NODE_ENV=production)
COOKIE_SECURE=0
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
