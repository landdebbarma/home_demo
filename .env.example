# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables (Production) instead — .env is not deployed.

# ---- Admin login -------------------------------------------------------------
ADMIN_EMAIL=ar.jeannejoseph@gmail.com
# Generate with:  npm run hash-password   (paste the printed value; never the password itself)
ADMIN_PASSWORD_HASH=
# Long random string (at least 32 characters). Changing it signs everyone out.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ---- GitHub (where content is stored) ---------------------------------------
GITHUB_OWNER=owner
GITHUB_REPO=repository
GITHUB_BRANCH=main

# Option A — GitHub App (recommended). Repository permissions: Contents (read & write),
# Deployments (read), Commit statuses (read). Install it on this repository only.
# Note: the App's private key goes here, not an installation token (those expire after an hour;
# the server mints fresh ones itself).
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# The full .pem contents including the BEGIN/END lines. On one line, write newlines as \n.
GITHUB_PRIVATE_KEY=

# Option B — fine-grained personal access token restricted to this repository, with the same
# permissions as above. Used instead of the App if set.
# GITHUB_TOKEN=

# Commit author shown on content commits. Use an email linked to a GitHub account with access to
# the Vercel project — Vercel may refuse to deploy commits from unrecognised authors.
COMMIT_AUTHOR_NAME=
COMMIT_AUTHOR_EMAIL=

# ---- Site --------------------------------------------------------------------
# Public URL for canonical links, sitemap and Open Graph. Optional on Vercel (the production
# domain is detected), but set it once you use a custom domain.
SITE_URL=
